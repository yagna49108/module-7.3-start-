<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Accessibility Data | Critical Web Design</title>

    <!-- 7.3 START
    Title: Accessibility Data
    Author(s): Owen Mundy, xtine burrough
